{
  "name": "kept-things",
  "version": "1.0.0",
  "description": "本地个人学习看板 — Pin & Paper 风格",
  "private": true,
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "repair-titles": "node server/scripts/repairTitles.js",
    "autostart:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-autostart.ps1",
    "autostart:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/uninstall-autostart.ps1",
    "autostart:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-server.ps1",
    "autostart:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/status-autostart.ps1",
    "tauri": "tauri",
    "tauri:prepare": "node scripts/prepare-tauri-sidecar.js",
    "tauri:dev": "npm run tauri:prepare && tauri dev",
    "tauri:build": "npm run tauri:prepare && tauri build"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.10",
    "cors": "^2.8.5",
    "epubjs": "^0.3.93",
    "express": "^4.19.2",
    "jszip": "^3.10.1",
    "multer": "^2.0.0",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  }
}
