{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kept Things",
  "version": "0.1.0",
  "identifier": "app.keptthings.desktop",
  "build": {
    "frontendDist": "../public"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/node"],
    "resources": {
      "../server": "kt-app/server",
      "../public": "kt-app/public",
      "../node_modules": "kt-app/node_modules"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
