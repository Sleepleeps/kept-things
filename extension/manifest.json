{
  "manifest_version": 3,
  "name": "Kept Things — 一键收藏",
  "version": "1.0.0",
  "description": "把当前网页一键收藏进本地的 Kept Things 学习看板（需要先用 npm start 启动本地服务器）",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": ["activeTab"],
  "host_permissions": ["http://localhost/*", "http://localhost:3000/*"]
}
